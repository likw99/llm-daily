# Copy to .env and fill in what you use. Only one LLM key is required.

# --- LLM: bring your own key -------------------------------------------------
# Option A: Anthropic (default provider)
ANTHROPIC_API_KEY=
# LLMDAILY_MODEL=claude-sonnet-5-5      # or claude-opus-5-5 for higher quality
# LLMDAILY_EFFORT=medium                # low | medium | high | xhigh | max
# LLMDAILY_FALLBACKS=on                 # "off" disables server-side refusal fallbacks

# Option B: any OpenAI-compatible API (OpenRouter, DeepSeek, Qwen, Ollama, GitHub Models, OpenAI)
# LLMDAILY_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# LLMDAILY_MODEL=deepseek/deepseek-chat

# --- Data sources ---------------------------------------------------------------
# Reddit (https://www.reddit.com/prefs/apps, "script" app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=llm-daily/1.0 (by /u/your_username)

# Optional: higher rate limits
# GITHUB_TOKEN=
# HF_TOKEN=
# PRODUCTHUNT_API_TOKEN=

# Optional: X list collector (needs `uv sync --extra x`; free API tier is very limited)
# X_BEARER_TOKEN=
# X_LIST_ID=

# Optional: alternative sources config
# LLMDAILY_SOURCES=config/sources.yaml

# --- Output ---------------------------------------------------------------------
# LLMDAILY_LANG=en                      # en | zh | both
# LLMDAILY_SITE_URL=https://you.github.io/llm-daily/

# --- Publishing -----------------------------------------------------------------
# Comma-separated: archive, kit, buttondown, telegram, webhook
# LLMDAILY_PUBLISHERS=archive

# Kit (https://kit.com, free up to 10,000 subscribers)
# KIT_API_KEY=
# KIT_STATUS=draft                      # draft | send
# KIT_SEGMENT_ID=
# KIT_TEMPLATE_ID=
# KIT_PUBLIC=false

# Buttondown
# BUTTONDOWN_API_KEY=
# NEWSLETTER_STATUS=draft               # draft | about_to_send

# Telegram (bot must be an admin of the channel)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=@your_channel

# Discord / Slack / Feishu / any JSON endpoint
# LLMDAILY_WEBHOOK_URL=
# LLMDAILY_WEBHOOK_FORMAT=              # discord | slack | feishu | json (default: from the URL)
